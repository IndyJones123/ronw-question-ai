# Konfigurasi backend login - COPY ke backend/.env dan isi!
#
# Database PostgreSQL (default: lokal PG17 port 5432)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=quiz_auth
DB_USER=quiz_auth
DB_PASSWORD=

# Rahasia buat tanda tangan token login (MIN 16 karakter!)
# Generate:  python -m backend.seed_user --gen-secret
AUTH_SECRET_KEY=
AUTH_TOKEN_TTL_HOURS=12

# Bind uvicorn (127.0.0.1 = hanya lokal, jangan terekspos ke LAN)
AUTH_BIND_HOST=127.0.0.1
AUTH_BIND_PORT=8000
