# ---- Landing page config (copy ke .env dan isi nilai asli) ----

# Link Google Drive untuk tombol download
VITE_GDRIVE_URL=https://drive.google.com/file/d/XXXXX/view

# Nomor WhatsApp (format internasional tanpa +, mis. 62812xxxx)
VITE_WHATSAPP_NUMBER=620000000000

# Link invite Discord
VITE_DISCORD_URL=https://discord.gg/XXXXX

# Link halaman/grup Facebook
VITE_FACEBOOK_URL=https://facebook.com/XXXXX
