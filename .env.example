COMMANDCODE_API_KEY=isi_api_key_kamu_di_sini
COMMANDCODE_BASE_URL=https://api.commandcode.ai/provider/v1
COMMANDCODE_MODEL=deepseek/deepseek-v4-flash
SYSTEM_PROMPT=You are a quiz answer bot. Look at the image, read the question and options, then reply with ONLY the final answer, as short as possible: option letter + short text (e.g. 'B) 42'). No explanation, no extra words, no markdown.
REQUEST_TIMEOUT=90

# ===== setelan kecepatan (untuk cepat-cepatan) =====
# streaming: jawaban muncul per potongan (huruf pilihan kelihatan paling awal). 0 = mati
COMMANDCODE_STREAM=1
# panaskan koneksi (DNS+TCP+TLS) sekali pas app dibuka, biar klik pertama juga cepat
COMMANDCODE_WARMUP=1
# 'off' = model nggak nalar dulu sebelum jawab -> paling berpengaruh buat kecepatan.
# kosongkan kalau model nolak / mau reasoning bawaan model
ANSWER_REASONING_EFFORT=off
# batas token jawaban. 128 aman utk jawaban pendek (dgn reasoning off, model berhenti duluan);
# naikkan (mis. 512) kalau ganti ke model yang nge-generate reasoning sendiri
ANSWER_MAX_TOKENS=128
# budget token saat jawaban kosong -> auto ulang sekali
ANSWER_RETRY_MAX_TOKENS=512
# 0 = deterministik. kosongkan (hapus nilai) kalau model nolak temperature
ANSWER_TEMPERATURE=0

# Optional OCR: install pytesseract + Tesseract binary, lalu uncomment:
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
